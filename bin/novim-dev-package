#!/bin/bash
# novim-dev-package - Offline package and install helper for novim-custom

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  novim-dev-package package OUTPUT_ARCHIVE
  novim-dev-package install ARCHIVE INSTALL_ROOT
  novim-dev-package --help

Commands:
  package  Create a deterministic local .tar.gz from this checkout.
  install  Extract an archive into a new or empty derivative install root.

The helper only packages or installs the derivative. It never fetches Git
data, calls a network service, or writes the installed `novim` release.
USAGE
}

resolve_target() {
  local target="$1"

  if [[ "$target" != /* ]]; then
    if [[ "$target" == */* ]]; then
      target="$(pwd -P)/$target"
    else
      target="$(command -v "$target" || echo "$target")"
      [[ "$target" != /* ]] && target="$(pwd -P)/$target"
    fi
  fi

  if command -v realpath >/dev/null 2>&1; then
    realpath "$target"
  else
    while [[ -L "$target" ]]; do
      local link
      link="$(readlink "$target")"
      if [[ "$link" == /* ]]; then
        target="$link"
      else
        target="$(cd "$(dirname "$target")" && pwd -P)/$link"
      fi
    done
    echo "$target"
  fi
}

SCRIPT_PATH="$(resolve_target "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
NOVIM_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"

STAGING_DIR=""
OUTPUT_TMP=""
cleanup() {
  if [[ -n "$OUTPUT_TMP" && -e "$OUTPUT_TMP" ]]; then
    rm -f "$OUTPUT_TMP"
  fi
  if [[ -n "$STAGING_DIR" && -d "$STAGING_DIR" ]]; then
    rm -rf "$STAGING_DIR"
  fi
}
trap cleanup EXIT

read_version() {
  local version_file="$NOVIM_ROOT/VERSION"
  if [[ ! -f "$version_file" ]]; then
    echo "Error: missing $version_file" >&2
    exit 1
  fi

  VERSION="$(tr -d '[:space:]' < "$version_file")"
  if [[ -z "$VERSION" || "$VERSION" == *[!0-9A-Za-z._-]* ]]; then
    echo "Error: VERSION must contain a simple package-safe identity." >&2
    exit 1
  fi
}

required_source_files() {
  local relative
  for relative in \
    bin/novim-dev \
    config/nvim \
    VERSION \
    LICENSE \
    THIRD_PARTY_LICENSES.md; do
    if [[ ! -e "$NOVIM_ROOT/$relative" ]]; then
      echo "Error: required package input is missing: $relative" >&2
      exit 1
    fi
  done
}

reject_private_or_runtime_entries() {
  local package_root="$1"
  local forbidden
  forbidden="$(find "$package_root" \( \
    -name '.git' -o \
    -name '.dev-*' -o \
    -name '.env' -o \
    -name '.env.*' -o \
    -iname '*credential*' -o \
    -iname '*secret*' -o \
    -iname '*.pem' -o \
    -iname '*.key' -o \
    -iname '*.sqlite*' -o \
    -iname '*.db' \
  \) -print -quit)"
  if [[ -n "$forbidden" ]]; then
    echo "Error: refusing to package private or runtime entry: $forbidden" >&2
    exit 1
  fi
}

create_package() {
  local output="$1"
  local output_dir
  local package_root
  local tar_file

  read_version
  required_source_files
  package_root="novim-custom-$VERSION"

  if [[ -e "$output" || -L "$output" ]]; then
    echo "Error: refusing to overwrite existing package: $output" >&2
    exit 1
  fi
  output_dir="$(dirname "$output")"
  mkdir -p "$output_dir"

  STAGING_DIR="$(mktemp -d "${TMPDIR:-/tmp}/novim_package_stage_XXXXXX")"
  mkdir -p "$STAGING_DIR/$package_root/bin" "$STAGING_DIR/$package_root/config"
  cp "$NOVIM_ROOT/bin/novim-dev" "$STAGING_DIR/$package_root/bin/novim-dev"
  cp -R "$NOVIM_ROOT/config/nvim" "$STAGING_DIR/$package_root/config/nvim"
  cp "$NOVIM_ROOT/VERSION" "$STAGING_DIR/$package_root/VERSION"
  cp "$NOVIM_ROOT/LICENSE" "$STAGING_DIR/$package_root/LICENSE"
  cp "$NOVIM_ROOT/THIRD_PARTY_LICENSES.md" "$STAGING_DIR/$package_root/THIRD_PARTY_LICENSES.md"
  chmod +x "$STAGING_DIR/$package_root/bin/novim-dev"
  reject_private_or_runtime_entries "$STAGING_DIR/$package_root"

  # Normalize staging metadata so repeated packaging of the same checkout is
  # byte-identical on the local platform. The archive has no source metadata.
  # BSD tar treats the exact Unix epoch as an invalid ustar timestamp; use a
  # fixed, representable timestamp one day after it instead.
  find "$STAGING_DIR/$package_root" -exec touch -t 197001020000 {} \;
  tar_file="$STAGING_DIR/package.tar"
  tar -cf "$tar_file" --format=ustar -C "$STAGING_DIR" "$package_root"
  OUTPUT_TMP="$output_dir/.novim-custom-package.$$"
  gzip -n -c "$tar_file" > "$OUTPUT_TMP"
  mv "$OUTPUT_TMP" "$output"
  OUTPUT_TMP=""

  echo "Package created: $output"
  echo "Identity: novim-custom $VERSION"
}

validate_archive() {
  local archive="$1"
  local manifest="$2"
  local first_entry
  local archive_root
  local entry

  tar -tzf "$archive" > "$manifest"
  if [[ ! -s "$manifest" ]]; then
    echo "Error: package archive is empty: $archive" >&2
    exit 1
  fi

  first_entry="$(sed -n '1p' "$manifest")"
  archive_root="${first_entry%%/*}"
  if [[ -z "$archive_root" || "$archive_root" != novim-custom-* ]]; then
    echo "Error: package archive has an invalid root directory." >&2
    exit 1
  fi

  while IFS= read -r entry; do
    case "$entry" in
      /*|../*|*/../*|*/..|..)
        echo "Error: refusing archive path traversal entry: $entry" >&2
        exit 1
        ;;
    esac
    case "$entry" in
      "$archive_root"|"$archive_root"/*) ;;
      *)
        echo "Error: archive contains more than one root: $entry" >&2
        exit 1
        ;;
    esac
  done < "$manifest"

  for required in \
    "$archive_root/bin/novim-dev" \
    "$archive_root/config/nvim/" \
    "$archive_root/config/nvim/init.lua" \
    "$archive_root/VERSION" \
    "$archive_root/LICENSE" \
    "$archive_root/THIRD_PARTY_LICENSES.md"; do
    if ! grep -Fqx "$required" "$manifest"; then
      echo "Error: package archive is missing required entry: $required" >&2
      exit 1
    fi
  done
  if grep -Fqx "$archive_root/bin/novim" "$manifest"; then
    echo "Error: package archive contains the installed-release launcher." >&2
    exit 1
  fi
  if grep -Eq '(^|/)\.git(/|$)|(^|/)\.dev-[^/]*(/|$)' "$manifest"; then
    echo "Error: package archive contains Git metadata or runtime state." >&2
    exit 1
  fi
  if grep -Eiq '(^|/)(\.env([.]|$)|.*credential.*|.*secret.*|.*\.(pem|key|sqlite|db))(/|$)' "$manifest"; then
    echo "Error: package archive contains a private or credential-like entry." >&2
    exit 1
  fi
  if tar -tvzf "$archive" | grep -Eq '^[[:space:]]*[bchlps]'; then
    echo "Error: package archive contains a link or special file." >&2
    exit 1
  fi
}

install_package() {
  local archive="$1"
  local install_root="$2"
  local manifest
  local target_created=0

  if [[ ! -f "$archive" ]]; then
    echo "Error: package archive does not exist: $archive" >&2
    exit 1
  fi
  if [[ -L "$install_root" ]]; then
    echo "Error: refusing to install through a symlink: $install_root" >&2
    exit 1
  fi
  if [[ -e "$install_root" && ! -d "$install_root" ]]; then
    echo "Error: install root is not a directory: $install_root" >&2
    exit 1
  fi

  if [[ -d "$install_root" ]]; then
    local entries=()
    shopt -s nullglob dotglob
    entries=("$install_root"/*)
    shopt -u nullglob dotglob
    if (( ${#entries[@]} > 0 )); then
      echo "Error: install root must be new or empty: $install_root" >&2
      exit 1
    fi
  else
    mkdir -p "$install_root"
    target_created=1
  fi

  STAGING_DIR="$(mktemp -d "${TMPDIR:-/tmp}/novim_install_check_XXXXXX")"
  manifest="$STAGING_DIR/manifest.txt"
  validate_archive "$archive" "$manifest"
  if ! tar -xzf "$archive" -C "$install_root" --strip-components=1; then
    if (( target_created == 1 )); then
      rm -rf "$install_root"
    fi
    echo "Error: failed to extract package: $archive" >&2
    exit 1
  fi
  chmod +x "$install_root/bin/novim-dev"

  echo "Package installed: $install_root"
  echo "Launcher: $install_root/bin/novim-dev"
}

main() {
  local command="${1:-}"
  case "$command" in
    package)
      if [[ "$#" -ne 2 ]]; then
        usage >&2
        exit 2
      fi
      create_package "$2"
      ;;
    install)
      if [[ "$#" -ne 3 ]]; then
        usage >&2
        exit 2
      fi
      install_package "$2" "$3"
      ;;
    --help|-h|"")
      usage
      ;;
    *)
      echo "Error: unknown command: $command" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
